# =============================================================================
# NovelVerse — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Fill in your local values or cloud service credentials below.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. DATABASE (MongoDB)
# -----------------------------------------------------------------------------
# Local MongoDB connection (default) or MongoDB Atlas connection string:
# Example Local: mongodb://127.0.0.1:27017/novelverse
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/novelverse?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://mohammedfareeddev_db_user:JoshuaKimmich6@cluster1.tyjni0r.mongodb.net/?appName=Cluster1

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# -----------------------------------------------------------------------------
# 32+ character secret key for HS256 JWT signing and cookie session verification
JWT_SECRET=novelverse_jwt_secret_key_change_in_production_min_32_characters_long_2026!

# -----------------------------------------------------------------------------
# 4. EXTERNAL BOOK CATALOG APIs
# -----------------------------------------------------------------------------
# Google Books API Key (Optional: works without key with standard rate limits)
# Get a key from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_BOOKS_API_KEY=

# -----------------------------------------------------------------------------
# 5. CLERK AUTHENTICATION (Optional / Future Integration)
# -----------------------------------------------------------------------------
# If using Clerk for user authentication or subscription management:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
CLERK_WEBHOOK_SECRET=
